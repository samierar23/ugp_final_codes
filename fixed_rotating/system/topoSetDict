FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

actions
(
    {
        name    porousCellLeft;
        type    cellSet;
        action  new;
        source  boxToCell;
        box     (0 0 0) (0.006 0.05 0.001);
    }

    {
        name    porousZoneLeft;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        set     porousCellLeft;
    }

    {
        name    porousCellRight;
        type    cellSet;
        action  new;
        source  boxToCell;
        box     (0.019 0 0) (0.025 0.05 0.001);
    }

    {
        name    porousZoneRight;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        set     porousCellRight;
    }

    {
        name    porousCellSet;
        type    cellSet;
        action  new;
        source  boxToCell;
        box     (0 0 0) (0.006 0.05 0.001);
    }

    {
        name    porousCellSet;
        type    cellSet;
        action  add;
        source  boxToCell;
        box     (0.019 0 0) (0.025 0.05 0.001);
    }

    {
        name    porousZones;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        set     porousCellSet;
    }
);
