FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}

defaultFieldValues
(
    volScalarFieldValue alpha.electrolyte 0
);

regions
(
    boxToCell
    {
        box (0.006 0.025 0) (0.019 0.045 0.001);
        fieldValues
        (
            volScalarFieldValue alpha.electrolyte 1
        );
    }
);
